{
  "name": "fikra-in-action",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:next": "next dev",
    "build": "if [ -n \"${FIREBASE_CONFIG:-}\" ] || [ -n \"${FIREBASE_WEBAPP_CONFIG:-}\" ]; then npm run build:next; else bash scripts/build-verified.sh; fi",
    "build:next": "next build",
    "build:sites": "bash scripts/build-verified.sh",
    "start": "next start",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs tests/rendered-html.test.mjs",
    "test:html": "node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:sites": "npm run build:sites && node --test tests/sites-preview.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern functions/lib",
    "migrate:dry-run": "node scripts/migrate-content.mjs --dry-run",
    "migrate": "node scripts/migrate-content.mjs",
    "seed:dry-run": "node scripts/seed-demo-content.mjs --dry-run",
    "seed": "node scripts/seed-demo-content.mjs",
    "firebase:grant-admin": "node scripts/set-firebase-admin.mjs",
    "firebase:set-role": "node scripts/set-user-role.mjs",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "npm --prefix functions run build && firebase deploy --only functions"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "isomorphic-dompurify": "^3.20.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "next-intl": "^4.13.4",
    "prettier": "^3.9.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "15.24.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Fikra in Action"
}
